# `connection_limit`/`pool_timeout` tune Prisma's connection pool — left off, Prisma defaults to
# `num_cpus * 2 + 1`, which is a guess, not a measurement. Set it explicitly in production: keep
# `connection_limit` comfortably under your MySQL server's `max_connections` divided by however
# many app instances/processes connect to it, so instances can't collectively exhaust the DB.
DATABASE_URL="mysql://aims_app:password@localhost:3306/aims?connection_limit=10&pool_timeout=10"

# JWT_ACCESS_TTL is how long a signed-in tab can go without silently refreshing (15m is normal —
# invisible to the user, the frontend refreshes automatically). JWT_REFRESH_TTL is the real
# session ceiling: /auth/refresh only ever re-issues the access token, never the refresh token
# itself, so this is an absolute "must log in again after this long" limit from the moment of
# login — not a sliding window that resets every time the app happens to be reopened.
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="24h"

PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

SEED_ADMIN_EMAIL="admin@amsol.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Email (SMTP) — invitations, password resets, notification digests. Left blank, the app runs
# fine but silently skips sending (EmailService.isConfigured() is false) — useful for local dev,
# but real use needs these set. Any standard SMTP provider works (Gmail app password, SES SMTP,
# Mailgun, Postmark, etc.).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AIMS <no-reply@yourdomain.com>"

# Object storage (documents/attachments) — left unset, uploads fall back to local disk (uploads/).
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Google Analytics 4 (Marketing → Website Analytics) — left unset, that module shows no data.
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_KEY_JSON=""

# Shared secret the amsol.africa website uses to call GET /public/blog/feed and
# POST /public/blog/engagement — see blogAPI.md. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` and give it only to
# whoever owns the website integration. Left unset, those two endpoints reject every request.
PUBLIC_BLOG_API_KEY=""
