# `connection_limit`/`pool_timeout` tune Prisma's connection pool — left off, Prisma defaults to
# `num_cpus * 2 + 1`, which is a guess, not a measurement. Set it explicitly in production: keep
# `connection_limit` comfortably under your MySQL server's `max_connections` divided by however
# many app instances/processes connect to it, so instances can't collectively exhaust the DB.
DATABASE_URL="mysql://aims_app:password@localhost:3306/aims?connection_limit=10&pool_timeout=10"

# JWT_ACCESS_TTL is how long a signed-in tab can go without silently refreshing (15m is normal —
# invisible to the user, the frontend refreshes automatically whenever it makes an API call).
# JWT_IDLE_TTL is the real session timeout: every successful /auth/refresh rolls the refresh
# cookie's expiry forward by this much, so it's a sliding window that expires the session after
# this long with zero API activity (tab idle, closed, laptop asleep, etc). JWT_REFRESH_TTL is a
# separate absolute ceiling from the moment of login — even a session that's continuously active
# (so the idle timer never fires) still has to fully log in again after this long.
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_IDLE_TTL="2h"
JWT_REFRESH_TTL="24h"

PORT=4000
NODE_ENV=development
# One origin, or several comma-separated (no brackets/quotes around the list, no spaces needed
# either way — they're trimmed) — e.g.:
# CORS_ORIGIN="https://management.amsol.africa,http://localhost:5173"
CORS_ORIGIN="http://localhost:3000"

SEED_ADMIN_EMAIL="admin@amsol.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Email (SMTP) — invitations, password resets, notification digests. Left blank, the app runs
# fine but silently skips sending (EmailService.isConfigured() is false) — useful for local dev,
# but real use needs these set. Any standard SMTP provider works (Gmail app password, SES SMTP,
# Mailgun, Postmark, etc.).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AIMS <no-reply@yourdomain.com>"

# SMS alerts through Africa's Talking (africastalking.com). Left blank, SMS is off.
# AT_USERNAME is your app's username ("sandbox" for the test environment), AT_API_KEY is from
# Settings > API Key, and AT_SENDER_ID is an approved alphanumeric sender ID or short code
# (optional; without it messages come from Africa's Talking's shared number).
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# WhatsApp alerts through the WhatsApp Cloud API. Alerts AIMS starts need an approved template
# with one body variable; set its name below. Left blank, WhatsApp is off.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Object storage (documents/attachments) — left unset, uploads fall back to local disk (uploads/).
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Google Analytics 4 (Marketing → Website Analytics) — left unset, that module shows no data.
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_KEY_JSON=""

# Shared secret the amsol.africa website uses to call GET /public/blog/feed and
# POST /public/blog/engagement — see blogAPI.md. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` and give it only to
# whoever owns the website integration. Left unset, those two endpoints reject every request.
PUBLIC_BLOG_API_KEY=""

# AI insights + chat (Water → AI panel, for now — see water/water-ai.service.ts). OpenAI is
# tried first; Gemini is used as a fallback whenever OpenAI errors or its key isn't set. Left
# fully unset, the feature shows a "not connected" state instead of erroring. Models default to
# gpt-4o-mini / gemini-2.0-flash when their *_MODEL var is left blank.
OPENAI_API_KEY=""
OPENAI_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL=""
